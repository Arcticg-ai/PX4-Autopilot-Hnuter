#!/bin/sh
#
# @name hnuter tiltrotor
# @class VTOL
#
# @type tiltrotor
#
# @output Motor1 xy1 right upper rotor
# @output Motor2 xy2 right lower rotor
# @output Motor3 xy3 left upper rotor
# @output Motor4 xy4 left lower rotor
# @output Motor5 xy5 rear reversible pitch rotor
# @output Servo1 rj2 right primary tilt
# @output Servo2 lj2 left primary tilt
# @output Servo3 rj1 right secondary tilt
# @output Servo4 lj1 left secondary tilt
#
# @maintainer hnuter <arcticg@foxmail.com>
#

. ${R}etc/init.d/rc.mc_defaults

# =============================================================================
# Hnuter Tiltrotor Real Hardware Airframe
# =============================================================================
#
# Actuator layout:
#
# Motors:
#   Motor 1 -> xy1 -> right upper
#   Motor 2 -> xy2 -> right lower
#   Motor 3 -> xy3 -> left upper
#   Motor 4 -> xy4 -> left lower
#   Motor 5 -> xy5 -> rear
#
# Tilt servos:
#   Servo 1 -> rj2
#   Servo 2 -> lj2
#   Servo 3 -> rj1
#   Servo 4 -> lj1
#
# Physical output mapping:
#   MAIN1-5  -> Motor 1-5
#   MAIN8-11 -> Servo 1-4
#
# CUAV 7-Nano / Pixhawk 6X expose the tested Hnuter servo outputs as MAIN8-11
# in PX4. Keep the airframe on those channels so actuator_servos[0..3] reaches
# the same physical pins used by the validated external direct controller.
#

# =============================================================================
# System / Vehicle Type
# =============================================================================

# Multicopter type.
# Although the vehicle is a tiltrotor, we do not use PX4 standard VTOL transition logic.
# Custom ActuatorEffectivenessHnuter handles the nonlinear allocation.
param set-default MAV_TYPE 2

# Enable PX4 Control Allocator if this parameter exists in your PX4 version.
# If your PX4 version has no SYS_CTRL_ALLOC parameter, this line can be removed.
param set-default SYS_CTRL_ALLOC 1

# Hnuter's custom controller/allocator maps HNTR_HOV_THR to vehicle weight and
# full throttle to the four front motors. Motor 5 is a reversible pitch actuator.
param set-default MPC_THR_HOVER 0.50
param set-default MPC_THR_MIN 0.12
param set-default MPC_USE_HTE 0

# =============================================================================
# Real Hardware Actuator Mapping
# =============================================================================
#
# PX4 actuator function values:
#   101-108 -> Motor 1-8
#   201-208 -> Servo 1-8
#
# MAIN1-5 are used for ESCs.
# MAIN8-11 are used for tilt servos on the tested real aircraft.
#

# -----------------------------
# MAIN PWM: Motors
# -----------------------------

param set PWM_MAIN_FUNC1 101  # MAIN1 -> Motor 1 -> xy1, right upper
param set PWM_MAIN_FUNC2 102  # MAIN2 -> Motor 2 -> xy2, right lower
param set PWM_MAIN_FUNC3 103  # MAIN3 -> Motor 3 -> xy3, left upper
param set PWM_MAIN_FUNC4 104  # MAIN4 -> Motor 4 -> xy4, left lower
param set PWM_MAIN_FUNC5 105  # MAIN5 -> Motor 5 -> xy5, rear

# MAIN8-11 are the tested physical tilt-servo outputs on the real aircraft.
param set PWM_MAIN_FUNC6 0
param set PWM_MAIN_FUNC7 0
param set PWM_MAIN_FUNC8 201   # MAIN8  -> Servo 1 -> rj2
param set PWM_MAIN_FUNC9 202   # MAIN9  -> Servo 2 -> lj2
param set PWM_MAIN_FUNC10 203  # MAIN10 -> Servo 3 -> rj1
param set PWM_MAIN_FUNC11 204  # MAIN11 -> Servo 4 -> lj1
param set PWM_MAIN_FUNC12 0
param set PWM_MAIN_FUNC13 0
param set PWM_MAIN_FUNC14 0

# Force the motor timer groups onto regular PWM. Saved timer values from other
# airframes must not leave the ESC calibration path on an unexpected rate/protocol.
param set PWM_MAIN_TIM0 400
param set PWM_MAIN_TIM1 400
param set PWM_MAIN_TIM2 50
param set PWM_MAIN_TIM3 50

# ESC PWM range.
# MAIN1-4 are ordinary one-way ESCs:
#   1000 us low throttle, 2000 us high throttle.
# MAIN5 uses a reversible ESC with stop around 1450 us.
# If your ESCs use OneShot/DShot/CAN, this section must be adjusted accordingly.
param set PWM_MAIN_MIN1 1000
param set PWM_MAIN_MIN2 1000
param set PWM_MAIN_MIN3 1000
param set PWM_MAIN_MIN4 1000
param set PWM_MAIN_MIN5 900

param set PWM_MAIN_MAX1 2000
param set PWM_MAIN_MAX2 2000
param set PWM_MAIN_MAX3 2000
param set PWM_MAIN_MAX4 2000
param set PWM_MAIN_MAX5 2000

param set-default PWM_MAIN_MIN8 1000
param set-default PWM_MAIN_MIN9 1000
param set-default PWM_MAIN_MIN10 1000
param set-default PWM_MAIN_MIN11 1000

param set-default PWM_MAIN_MAX8 2000
param set-default PWM_MAIN_MAX9 2000
param set-default PWM_MAIN_MAX10 2000
param set-default PWM_MAIN_MAX11 2000

# Disarmed output.
# MAIN1-4 use low PWM for one-way ESC stop. MAIN5 uses its reversible ESC stop point.
param set PWM_MAIN_DIS1 900
param set PWM_MAIN_DIS2 900
param set PWM_MAIN_DIS3 900
param set PWM_MAIN_DIS4 900
param set PWM_MAIN_DIS5 1450
param set-default PWM_MAIN_DIS8 1500
param set-default PWM_MAIN_DIS9 1500
param set-default PWM_MAIN_DIS10 1500
param set-default PWM_MAIN_DIS11 1500

# Failsafe output.
param set PWM_MAIN_FAIL1 900
param set PWM_MAIN_FAIL2 900
param set PWM_MAIN_FAIL3 900
param set PWM_MAIN_FAIL4 900
param set PWM_MAIN_FAIL5 1450
param set-default PWM_MAIN_FAIL8 1500
param set-default PWM_MAIN_FAIL9 1500
param set-default PWM_MAIN_FAIL10 1500
param set-default PWM_MAIN_FAIL11 1500

# Default to no PWM output reversal. Keep this as a default so QGC actuator
# calibration can persist servo reverse settings across reboot.
param set-default PWM_MAIN_REV 0

# -----------------------------
# AUX PWM: unused for the tested hardware wiring
# -----------------------------

param set-default PWM_AUX_FUNC1 0
param set-default PWM_AUX_FUNC2 0
param set-default PWM_AUX_FUNC3 0
param set-default PWM_AUX_FUNC4 0
param set-default PWM_AUX_FUNC5 0
param set-default PWM_AUX_FUNC6 0
param set-default PWM_AUX_FUNC7 0
param set-default PWM_AUX_FUNC8 0

# AUX servo PWM range is left at neutral defaults in case AUX outputs are
# manually repurposed later. The Hnuter tilt servos are mapped on MAIN8-11 above.
param set-default PWM_AUX_MIN1 1000
param set-default PWM_AUX_MIN2 1000
param set-default PWM_AUX_MIN3 1000
param set-default PWM_AUX_MIN4 1000

param set-default PWM_AUX_MAX1 2000
param set-default PWM_AUX_MAX2 2000
param set-default PWM_AUX_MAX3 2000
param set-default PWM_AUX_MAX4 2000

# Disarmed servo position.
# 1500 us means neutral/middle position.
param set-default PWM_AUX_DIS1 1500
param set-default PWM_AUX_DIS2 1500
param set-default PWM_AUX_DIS3 1500
param set-default PWM_AUX_DIS4 1500

# Failsafe servo position.
param set-default PWM_AUX_FAIL1 1500
param set-default PWM_AUX_FAIL2 1500
param set-default PWM_AUX_FAIL3 1500
param set-default PWM_AUX_FAIL4 1500

# =============================================================================
# Control Allocator Configuration
# =============================================================================

# Select custom effectiveness model.
# 16 should correspond to ActuatorEffectivenessHnuter in your PX4 code.
# QGC cannot describe this aircraft's two-stage tilt geometry. Keep the
# physical function mapping above and let ActuatorEffectivenessHnuter publish:
#   actuator_motors[0..4] -> Motor 1..5
#   actuator_servos[0..3] -> Servo 1..4
param set-default CA_AIRFRAME 16

# 5 rotors.
param set-default CA_ROTOR_COUNT 5

# Motor 5 is reversible. This makes actuator_motors[4] use signed [-1, 1]
# semantics, so zero maps to the PWM center instead of low throttle.
param set CA_R_REV 16

# -----------------------------
# Rotor Geometry
# -----------------------------

# Motor 0: xy1, right arm upper, CCW
param set-default CA_ROTOR0_PX 0.0
param set-default CA_ROTOR0_PY 0.2
param set-default CA_ROTOR0_PZ 0.05
param set-default CA_ROTOR0_KM -0.05

# Motor 1: xy2, right arm lower, CW
param set-default CA_ROTOR1_PX 0.0
param set-default CA_ROTOR1_PY 0.2
param set-default CA_ROTOR1_PZ -0.05
param set-default CA_ROTOR1_KM 0.05

# Motor 2: xy3, left arm upper, CCW
param set-default CA_ROTOR2_PX 0.0
param set-default CA_ROTOR2_PY -0.2
param set-default CA_ROTOR2_PZ 0.05
param set-default CA_ROTOR2_KM -0.05

# Motor 3: xy4, left arm lower, CW
param set-default CA_ROTOR3_PX 0.0
param set-default CA_ROTOR3_PY -0.2
param set-default CA_ROTOR3_PZ -0.05
param set-default CA_ROTOR3_KM 0.05

# Motor 4: xy5, rear, CCW
param set-default CA_ROTOR4_PX -0.4
param set-default CA_ROTOR4_PY 0.0
param set-default CA_ROTOR4_PZ 0.0
param set-default CA_ROTOR4_KM -0.05

# QGC actuator geometry only has one CA_ROTORx_TILT slot per rotor.
# Use the first-stage tilt here; QGC derives the second-stage mapping from
# the 4-servo Hnuter layout: Tilt 1 -> Tilt 3, Tilt 2 -> Tilt 4.
param set-default CA_ROTOR0_TILT 1
param set-default CA_ROTOR1_TILT 1
param set-default CA_ROTOR2_TILT 2
param set-default CA_ROTOR3_TILT 2
param set-default CA_ROTOR4_TILT 0

# =============================================================================
# Tilt Servo Configuration
# =============================================================================
#
# CA_SV_TL_COUNT=4 ensures _tilts.addActuators() registers 4 servo actuators.
#
# CT=0:
#   PX4 standard tilt logic does not write the effectiveness matrix.
#   The custom updateSetpoint() in ActuatorEffectivenessHnuter fully controls
#   the tilt angles through your nonlinear inverse mapping.
#

param set-default CA_SV_TL_COUNT 4

# Tilt 0: rj2, right arm primary, yaw axis
param set-default CA_SV_TL0_MAXA 185
param set-default CA_SV_TL0_MINA -185
param set-default CA_SV_TL0_TD 0
param set-default CA_SV_TL0_CT 0

# Tilt 1: lj2, left arm primary, yaw axis
param set-default CA_SV_TL1_MAXA 185
param set-default CA_SV_TL1_MINA -185
param set-default CA_SV_TL1_TD 0
param set-default CA_SV_TL1_CT 0

# Tilt 2: rj1, right arm secondary, roll axis
param set-default CA_SV_TL2_MAXA 180
param set-default CA_SV_TL2_MINA -180
param set-default CA_SV_TL2_TD 90
param set-default CA_SV_TL2_CT 0

# Tilt 3: lj1, left arm secondary, roll axis
param set-default CA_SV_TL3_MAXA 180
param set-default CA_SV_TL3_MINA -180
param set-default CA_SV_TL3_TD 90
param set-default CA_SV_TL3_CT 0

# =============================================================================
# MC Position Controller Tuning
# =============================================================================

param set-default HNTR_CTRL_MODE 0
param set-default HNTR_MASS 4.5
param set-default HNTR_MAX_ARM_T 170.96
param set-default HNTR_MAX_TAIL_T 85.48
param set-default HNTR_L1 0.33
param set-default HNTR_L2 0.664
param set-default HNTR_HOV_THR 0.65
param set-default HNTR_XY_P 2.5
param set-default HNTR_Z_P 8.0
param set-default HNTR_XY_D 1.8
param set-default HNTR_Z_D 4.0
param set-default HNTR_XY_I 0.0
param set-default HNTR_Z_I 3.0
param set-default HNTR_ACC_XY 20.0
param set-default HNTR_ACC_Z 65.0
param set-default HNTR_TILT_MAX 185.0
param set-default HNTR_TO_SUP_T 1.0
param set-default HNTR_TO_LOCK_T 3.0
param set-default HNTR_TO_TILT 20.0
param set-default HNTR_LOCK_TILT 30.0
param set-default HNTR_LOCK_ACC 3.0
param set-default HNTR_LOCK_KP 0.8
param set-default HNTR_ATT_KR_R 8.0
param set-default HNTR_ATT_KR_P 8.0
param set-default HNTR_ATT_KR_Y 1.5
param set-default HNTR_ATT_D_R 2.0
param set-default HNTR_ATT_D_P 2.0
param set-default HNTR_ATT_D_Y 1.2
param set-default HNTR_TAU_R 0.9
param set-default HNTR_TAU_P 0.9
param set-default HNTR_TAU_Y 1.8

param set-default MPC_XY_P 1.875
param set-default MPC_XY_VEL_P_ACC 8.0
param set-default MPC_XY_VEL_I_ACC 0.5
param set-default MPC_XY_VEL_D_ACC 4.0

param set-default MPC_Z_P 2.5
param set-default MPC_Z_VEL_P_ACC 12.0
param set-default MPC_Z_VEL_I_ACC 0.5
param set-default MPC_Z_VEL_D_ACC 6.0

# =============================================================================
# MC Attitude / Rate Controller Tuning
# =============================================================================

param set-default MC_ROLL_P 5.0
param set-default MC_PITCH_P 5.0
param set-default MC_YAW_P 4.0

param set-default MC_ROLLRATE_P 0.14
param set-default MC_ROLLRATE_I 0.0
param set-default MC_ROLLRATE_D 0.001

param set-default MC_PITCHRATE_P 0.052
param set-default MC_PITCHRATE_I 0.0
param set-default MC_PITCHRATE_D 0.001

param set-default MC_YAWRATE_P 0.117
param set-default MC_YAWRATE_I 0.0
param set-default MC_YAWRATE_D 0.001

param set-default MC_AIRMODE 1

# Land detector / auto-disarm. These are forced because stale bench-test
# values can persist across airframe switches and keep the vehicle armed.
param set COM_DISARM_PRFLT 10
param set COM_DISARM_LAND 1
param set LNDMC_TRIG_TIME 0.5
param set LNDMC_ROT_MAX 35

# =============================================================================
# Sensor & EKF
# =============================================================================

# No airspeed sensor.
param set-default SYS_HAS_NUM_ASPD 0

# GPS checks.
# If you fly indoor / mocap / VIO / offboard without GPS, these should be adjusted
# together with your estimator source configuration.
param set-default EKF2_GPS_CHECK 21
param set-default EKF2_REQ_GPS_H 10

# =============================================================================
# Arming & Safety for Real Hardware
# =============================================================================
#
# WARNING:
# The original file used several simulation-style safety bypasses.
# For real hardware, do not disable too many checks unless you are doing
# propeller-removed bench tests or tethered indoor tests.
#

# Allow arming without GPS.
# Keep this if you are using indoor VIO/mocap/offboard or bench tests.
param set-default COM_ARM_WO_GPS 1

# Magnetic heading check tolerance.
param set-default COM_ARM_MAG_ANG 60

# ESC check.
# Keep 0 only if your ESC telemetry/check path is not used.
param set-default COM_ARM_CHK_ESCS 0

# ESC failure detector.
# Keep disabled if ESC telemetry is unavailable.
param set-default FD_ESCS_EN 0

# Do NOT disable supply / USB checks by default on real hardware.
# If you are doing bench tests and really need these, uncomment manually:
# param set-default CBRK_SUPPLY_CHK 894281
# param set-default CBRK_USB_CHK 197848

# =============================================================================
# RC & Flight Modes
# =============================================================================

# RC input mode.
# Keep the original setting from your file.
# If you need manual RC fallback, verify this parameter in QGC.
param set-default COM_RC_IN_MODE 1

param set-default RC_MAP_FLTMODE 5
param set-default RC_MAP_AUX1 6
param set-default RC_MAP_AUX2 7

# Flight mode switch positions.
param set-default COM_FLTMODE1 0
param set-default COM_FLTMODE2 2
param set-default COM_FLTMODE3 7
param set-default COM_FLTMODE4 8
param set-default COM_FLTMODE5 7
param set-default COM_FLTMODE6 0

# =============================================================================
# Offboard / Failsafe Behavior
# =============================================================================
#
# These settings should be chosen according to your test environment.
# For indoor bench or tethered tests, you may want less aggressive failsafe actions.
# For outdoor free flight, keep conservative failsafes enabled.
#

# Low battery action.
# Original file disables low battery action with 0.
# For real free flight, consider using warning/return/land behavior instead.
param set-default COM_LOW_BAT_ACT 0

# RC loss action.
# Original file disables RC loss action with 0.
# This is acceptable only if you are intentionally flying pure offboard
# or using another external safety mechanism.
param set-default NAV_RCL_ACT 0

# Mission takeoff altitude.
param set-default MIS_TAKEOFF_ALT 10

# =============================================================================
# End of Airframe
# =============================================================================
