<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="hnuter_sphere">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>true</grid>
      <ambient>0.48 0.48 0.50 1</ambient>
      <background>0.66 0.72 0.80 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.52 0.55 0.53 1</ambient>
            <diffuse>0.52 0.55 0.53 1</diffuse>
            <specular>0.18 0.18 0.18 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="start_pad">
      <static>true</static>
      <pose>0 0 0.015 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>2.5</radius><length>0.03</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.42 0.34 1</ambient>
            <diffuse>0.12 0.42 0.34 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The controller commands its origin 0.10 m inside the sphere for contact preload. -->
    <model name="giant_sphere">
      <static>true</static>
      <pose>14 0 11.5 0 0 0</pose>
      <link name="sphere">
        <collision name="collision">
          <geometry><sphere><radius>10.0</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.02</mu>
                <mu2>0.02</mu2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.0</restitution_coefficient>
              <threshold>0.2</threshold>
            </bounce>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>meshes/hnuter_sphere_smooth.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.13 0.34 0.62 1</ambient>
            <diffuse>0.16 0.42 0.76 1</diffuse>
            <specular>0.38 0.38 0.42 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="sphere_pedestal">
      <static>true</static>
      <pose>14 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>1.2</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>1.2</radius><length>1.5</length></cylinder></geometry>
          <material>
            <ambient>0.30 0.31 0.34 1</ambient>
            <diffuse>0.34 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Markers follow the commanded upper-surface great-circle path. -->
    <model name="surface_path_markers">
      <static>true</static>
      <pose>14 0 11.5 0 0 0</pose>
      <link name="marker_01">
        <pose>0 0 10.06 0 0 0</pose>
        <visual name="visual">
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.95 0.76 0.16 1</ambient><diffuse>0.95 0.76 0.16 1</diffuse></material>
        </visual>
      </link>
      <link name="marker_02">
        <pose>3.441 0 9.453 0 0 0</pose>
        <visual name="visual">
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.94 0.88 0.74 1</ambient><diffuse>0.94 0.88 0.74 1</diffuse></material>
        </visual>
      </link>
      <link name="marker_03">
        <pose>6.467 0 7.706 0 0 0</pose>
        <visual name="visual">
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.95 0.76 0.16 1</ambient><diffuse>0.95 0.76 0.16 1</diffuse></material>
        </visual>
      </link>
      <link name="marker_04">
        <pose>8.712 0 5.03 0 0 0</pose>
        <visual name="visual">
          <geometry><sphere><radius>0.24</radius></sphere></geometry>
          <material><ambient>0.90 0.30 0.20 1</ambient><diffuse>0.90 0.30 0.20 1</diffuse></material>
        </visual>
      </link>
      <link name="marker_05">
        <pose>9.907 0 1.747 0 0 0</pose>
        <visual name="visual">
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.95 0.76 0.16 1</ambient><diffuse>0.95 0.76 0.16 1</diffuse></material>
        </visual>
      </link>
      <link name="marker_06">
        <pose>9.907 0 -1.747 0 0 0</pose>
        <visual name="visual">
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.94 0.88 0.74 1</ambient><diffuse>0.94 0.88 0.74 1</diffuse></material>
        </visual>
      </link>
      <link name="marker_07">
        <pose>8.712 0 -5.03 0 0 0</pose>
        <visual name="visual">
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.95 0.76 0.16 1</ambient><diffuse>0.95 0.76 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.1</intensity>
      <direction>-0.25 0.45 -0.86</direction>
      <diffuse>0.92 0.92 0.90 1</diffuse>
      <specular>0.28 0.28 0.28 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
