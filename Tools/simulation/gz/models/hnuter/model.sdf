<sdf version='1.11'>
  <model name='hnuter'>
    <self_collide>false</self_collide>
    <!-- Spawn on the landing pads. Starting one metre above ground lets the
         disarmed model free-fall and occasionally settle at a large attitude
         before PX4 completes preflight checks. -->
